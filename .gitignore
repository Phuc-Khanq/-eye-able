# Python
.venv/
__pycache__/
*.pyc

# Models and user data: never commit
models/*
!models/README.md
recordings/
!tests/recordings/
tests/recordings/*
# Only the made-up demo is shared. Real sessions (record_events saves them here) can
# contain the words someone dictated, so they stay on the laptop.
!tests/recordings/demo_flow.jsonl
# all_messages.jsonl is made from the real pieces with fake input (no one's speech), for Nhi
!tests/recordings/all_messages.jsonl
calibration/

# Training data, checkpoints and downloaded Kaggle results (TORGO is never published)
data/
checkpoints/
downloads/
*.wav
*.mp4

# Secrets and per-laptop settings
.env
config.local.json
config.local.json.*

# Release zips (scripts/make_release.ps1)
dist/

# Front end
ui/node_modules/
ui/out/
ui/dist/

# Private team notes (roles, judge prep). Keep out of the public repo.
# (the wildcards also match the same files under their old names, so renaming a local copy never exposes it)
*_Project_Description.md
*Build Plan.md
*Handoff*.md
